{
  "name": "@garita/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Tipos, constantes y esquemas Zod compartidos entre la API, el panel web y la app móvil",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@garita/eslint-config": "workspace:*",
    "@garita/typescript-config": "workspace:*",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "eslint": "catalog:",
    "jest": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
