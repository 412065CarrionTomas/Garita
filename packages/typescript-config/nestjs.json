{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS (CommonJS)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "types": ["node", "jest"]
  }
}
