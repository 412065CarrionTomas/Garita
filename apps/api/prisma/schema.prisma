// Esquema de la base de datos de Garita.
// Todo cambio pasa por una migración: pnpm --filter api db:migrate --name <nombre_descriptivo>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // La API compila a CommonJS; el cliente se genera en el mismo formato.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  supervisor
  guard
  client
}

enum UserStatus {
  invitation_pending
  active
  deactivated
}

enum InvitationSendStatus {
  pending
  sent
  failed
}

enum RecordStatus {
  active
  inactive
}

enum NfcTagStatus {
  active
  replaced
  removed
}

model Company {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Argentina/Buenos_Aires")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  sites     Site[]
  rounds    Round[]
}

model User {
  id              String           @id @default(cuid())
  companyId       String
  firebaseUid     String           @unique
  email           String           @unique
  firstName       String
  lastName        String
  phone           String?
  employeeNumber  String?
  role            UserRole
  status          UserStatus       @default(invitation_pending)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitations     Invitation[]
  siteAssignments SiteSupervisor[]

  @@index([companyId])
}

model Client {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  contactName String
  phone       String
  email       String
  taxId       String?
  status      RecordStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sites       Site[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model Site {
  id                 String           @id @default(cuid())
  companyId          String
  clientId           String
  name               String
  address            String
  latitude           Decimal          @db.Decimal(9, 6)
  longitude          Decimal          @db.Decimal(10, 6)
  accessInstructions String?
  observations       String?
  status             RecordStatus     @default(active)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supervisors        SiteSupervisor[]
  checkpoints        Checkpoint[]
  rounds             Round[]

  @@unique([clientId, name])
  @@index([companyId, status])
  @@index([clientId])
}

model SiteSupervisor {
  id         String   @id @default(cuid())
  companyId  String
  siteId     String
  userId     String
  assignedAt DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([companyId])
  @@index([userId])
}

model Checkpoint {
  id                    String       @id @default(cuid())
  companyId             String
  siteId                String
  name                  String
  latitude              Decimal      @db.Decimal(9, 6)
  longitude             Decimal      @db.Decimal(10, 6)
  toleranceRadiusMeters Int          @default(30)
  stickerLocation       String?
  isIndoor              Boolean      @default(false)
  qrVersion             Int          @default(1)
  status                RecordStatus @default(active)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  site                  Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  nfcTags               NfcTag[]
  roundVersions         RoundVersionCheckpoint[]

  @@unique([siteId, name])
  @@index([companyId, status])
  @@index([siteId, status])
}

model NfcTag {
  id             String       @id @default(cuid())
  companyId      String
  checkpointId   String
  uid            String
  status         NfcTagStatus @default(active)
  associatedById String
  associatedAt   DateTime     @default(now())
  endedAt        DateTime?
  endedById      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  @@index([companyId, checkpointId, status])
  @@index([uid, status])
}

model Round {
  id              String       @id @default(cuid())
  companyId       String
  siteId          String
  name            String
  status          RecordStatus @default(active)
  currentVersionId String?     @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  versions        RoundVersion[]
  currentVersion  RoundVersion? @relation("CurrentRoundVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([siteId, name])
  @@index([companyId, status])
  @@index([siteId, status])
}

model RoundVersion {
  id               String                    @id @default(cuid())
  roundId          String
  versionNumber    Int
  frequencyMinutes Int
  windowStartLocal String
  windowEndLocal   String
  graceMinutes     Int
  createdById      String
  createdAt        DateTime                  @default(now())
  round            Round                     @relation(fields: [roundId], references: [id], onDelete: Restrict)
  currentFor       Round?                    @relation("CurrentRoundVersion")
  checkpoints      RoundVersionCheckpoint[]

  @@unique([roundId, versionNumber])
  @@index([roundId, createdAt])
}

model RoundVersionCheckpoint {
  id             String       @id @default(cuid())
  companyId      String
  roundVersionId String
  checkpointId   String
  position       Int
  roundVersion   RoundVersion @relation(fields: [roundVersionId], references: [id], onDelete: Restrict)
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  @@unique([roundVersionId, checkpointId])
  @@unique([roundVersionId, position])
  @@index([checkpointId])
}

model Invitation {
  id                String               @id @default(cuid())
  userId            String
  tokenHash         String               @unique
  expiresAt         DateTime
  usedAt            DateTime?
  replacedAt        DateTime?
  sendStatus        InvitationSendStatus @default(pending)
  providerMessageId String?
  createdAt         DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
