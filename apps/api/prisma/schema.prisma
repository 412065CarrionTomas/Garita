// Esquema de la base de datos de Garita.
// Todo cambio pasa por una migración: pnpm --filter api db:migrate --name <nombre_descriptivo>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // La API compila a CommonJS; el cliente se genera en el mismo formato.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  supervisor
  guard
  client
}

enum UserStatus {
  invitation_pending
  active
  deactivated
}

enum InvitationSendStatus {
  pending
  sent
  failed
}

enum RecordStatus {
  active
  inactive
}

enum NfcTagStatus {
  active
  replaced
  removed
}

model Company {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("America/Argentina/Buenos_Aires")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  sites     Site[]
  rounds    Round[]
  shifts    Shift[]
}

model User {
  id              String           @id @default(cuid())
  companyId       String
  firebaseUid     String           @unique
  email           String           @unique
  firstName       String
  lastName        String
  phone           String?
  employeeNumber  String?
  role            UserRole
  status          UserStatus       @default(invitation_pending)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitations     Invitation[]
  siteAssignments SiteSupervisor[]
  createdShifts Shift[] @relation("ShiftCreator")
  shiftAssignments ShiftAssignment[]

  @@index([companyId])
}

model Client {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  contactName String
  phone       String
  email       String
  taxId       String?
  status      RecordStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sites       Site[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model Site {
  id                 String           @id @default(cuid())
  companyId          String
  clientId           String
  name               String
  address            String
  latitude           Decimal          @db.Decimal(9, 6)
  longitude          Decimal          @db.Decimal(10, 6)
  accessInstructions String?
  observations       String?
  status             RecordStatus     @default(active)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supervisors        SiteSupervisor[]
  checkpoints        Checkpoint[]
  rounds             Round[]
  shifts             Shift[]

  @@unique([clientId, name])
  @@index([companyId, status])
  @@index([clientId])
}

model SiteSupervisor {
  id         String   @id @default(cuid())
  companyId  String
  siteId     String
  userId     String
  assignedAt DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([companyId])
  @@index([userId])
}

model Checkpoint {
  id                    String       @id @default(cuid())
  companyId             String
  siteId                String
  name                  String
  latitude              Decimal      @db.Decimal(9, 6)
  longitude             Decimal      @db.Decimal(10, 6)
  toleranceRadiusMeters Int          @default(30)
  stickerLocation       String?
  isIndoor              Boolean      @default(false)
  qrVersion             Int          @default(1)
  status                RecordStatus @default(active)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  site                  Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  nfcTags               NfcTag[]
  roundVersions         RoundVersionCheckpoint[]
  records               CheckpointRecord[]

  @@unique([siteId, name])
  @@index([companyId, status])
  @@index([siteId, status])
}

model NfcTag {
  id             String       @id @default(cuid())
  companyId      String
  checkpointId   String
  uid            String
  status         NfcTagStatus @default(active)
  associatedById String
  associatedAt   DateTime     @default(now())
  endedAt        DateTime?
  endedById      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  @@index([companyId, checkpointId, status])
  @@index([uid, status])
}

model Round {
  id              String       @id @default(cuid())
  companyId       String
  siteId          String
  name            String
  status          RecordStatus @default(active)
  currentVersionId String?     @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site            Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  versions        RoundVersion[]
  currentVersion  RoundVersion? @relation("CurrentRoundVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  shifts          ShiftRound[]

  @@unique([siteId, name])
  @@index([companyId, status])
  @@index([siteId, status])
}

model RoundVersion {
  id               String                    @id @default(cuid())
  roundId          String
  versionNumber    Int
  frequencyMinutes Int
  windowStartLocal String
  windowEndLocal   String
  graceMinutes     Int
  createdById      String
  createdAt        DateTime                  @default(now())
  round            Round                     @relation(fields: [roundId], references: [id], onDelete: Restrict)
  currentFor       Round?                    @relation("CurrentRoundVersion")
  checkpoints      RoundVersionCheckpoint[]
  shifts           ShiftRound[]

  @@unique([roundId, versionNumber])
  @@index([roundId, createdAt])
}

model RoundVersionCheckpoint {
  id             String       @id @default(cuid())
  companyId      String
  roundVersionId String
  checkpointId   String
  position       Int
  roundVersion   RoundVersion @relation(fields: [roundVersionId], references: [id], onDelete: Restrict)
  checkpoint     Checkpoint   @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  @@unique([roundVersionId, checkpointId])
  @@unique([roundVersionId, position])
  @@index([checkpointId])
}

model Invitation {
  id                String               @id @default(cuid())
  userId            String
  tokenHash         String               @unique
  expiresAt         DateTime
  usedAt            DateTime?
  replacedAt        DateTime?
  sendStatus        InvitationSendStatus @default(pending)
  providerMessageId String?
  createdAt         DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ShiftStatus {
  scheduled
  unassigned
  cancelled
  in_progress
  closed
  auto_closed
}

enum ShiftEventType {
  start
  close
  auto_close
  admin_close
}

enum ShiftEventLocationStatus {
  ok
  unverifiable
  disabled
}

enum ShiftEventSimulation {
  simulated
  not_simulated
  unavailable
}

enum ShiftClosedBy {
  guard
  admin
  system
}

model Shift {
  id                 String            @id @default(cuid())
  companyId          String
  siteId             String
  startsAt           DateTime          @db.Timestamptz(3)
  endsAt             DateTime          @db.Timestamptz(3)
  serviceDate        DateTime          @db.Date
  status             ShiftStatus       @default(scheduled)
  createdById        String
  cancelledAt        DateTime?         @db.Timestamptz(3)
  cancelledById      String?
  cancellationReason String?
  startedAt          DateTime?         @db.Timestamptz(3)
  lateStartMinutes   Int?
  closedAt           DateTime?         @db.Timestamptz(3)
  closedEarly        Boolean           @default(false)
  closeReason        String?
  closedBy           ShiftClosedBy?
  closedByUserId     String?
  autoClosedAt       DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  site               Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdBy          User              @relation("ShiftCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments        ShiftAssignment[]
  rounds             ShiftRound[]
  events             ShiftEvent[]
  checkpointRecords  CheckpointRecord[]
  invalidScanAttempts InvalidScanAttempt[]

  @@index([companyId, startsAt])
  @@index([siteId, serviceDate])
  @@index([status, startsAt])
}

model ShiftEvent {
  id                  String                    @id @default(cuid())
  companyId           String
  shiftId             String
  assignmentId        String
  type                ShiftEventType
  deviceEventId       String?                   @unique @db.Uuid
  occurredAt          DateTime                  @db.Timestamptz(3)
  occurredAtDevice    DateTime?                 @db.Timestamptz(3)
  receivedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  locationStatus      ShiftEventLocationStatus?
  latitude            Decimal?                  @db.Decimal(9, 6)
  longitude           Decimal?                  @db.Decimal(10, 6)
  accuracyMeters      Decimal?                  @db.Decimal(10, 2)
  simulation          ShiftEventSimulation?
  reason              String?
  actorUserId         String?
  lateStartMinutes    Int?
  countsForCompliance Boolean                   @default(true)
  response            Json?
  shift               Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignment          ShiftAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([companyId, shiftId, occurredAt])
  @@index([assignmentId, type])
}

model ShiftAssignment {
  id           String   @id @default(cuid())
  shiftId      String
  guardId      String?
  startsAt     DateTime @db.Timestamptz(3)
  endsAt       DateTime @db.Timestamptz(3)
  isCurrent    Boolean  @default(true)
  active       Boolean  @default(true)
  result       String?
  assignedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shift        Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  events       ShiftEvent[]
  checkpointRecords CheckpointRecord[]
  invalidScanAttempts InvalidScanAttempt[]
  guard        User?    @relation(fields: [guardId], references: [id], onDelete: Restrict)

  @@index([shiftId, isCurrent])
  @@index([guardId, startsAt, endsAt])
}

model ShiftRound {
  shiftId        String
  roundId        String
  roundVersionId String?
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  round          Round        @relation(fields: [roundId], references: [id], onDelete: Restrict)
  roundVersion   RoundVersion? @relation(fields: [roundVersionId], references: [id], onDelete: Restrict)

  @@id([shiftId, roundId])
  @@index([roundId])
}

enum CheckpointRecordMethod {
  qr
  nfc
}

enum PhoneNfcState {
  on
  off
  unsupported
}

enum InvalidScanReason {
  malformed
  signature
  other_site
  outdated_version
  unknown_checkpoint
  tag_not_associated
  tag_replaced
}

model CheckpointRecord {
  id                  String                    @id @default(cuid())
  companyId           String
  shiftId             String
  assignmentId        String
  checkpointId        String
  recordId            String                    @unique @db.Uuid
  method              CheckpointRecordMethod
  occurredAtDevice    DateTime                  @db.Timestamptz(3)
  receivedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  locationStatus      ShiftEventLocationStatus
  latitude            Decimal?                  @db.Decimal(9, 6)
  longitude           Decimal?                  @db.Decimal(10, 6)
  accuracyMeters      Decimal?                  @db.Decimal(10, 2)
  simulation          ShiftEventSimulation
  phoneNfc            PhoneNfcState
  countedFor          Json
  outOfWindow         Boolean                   @default(false)
  countsForCompliance Boolean                   @default(true)
  requestHash         String
  createdAt           DateTime                  @default(now())
  shift               Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignment          ShiftAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  checkpoint          Checkpoint                @relation(fields: [checkpointId], references: [id], onDelete: Restrict)

  @@index([companyId, shiftId, occurredAtDevice])
  @@index([shiftId, occurredAtDevice])
  @@index([checkpointId, occurredAtDevice])
}

model InvalidScanAttempt {
  id               String                    @id @default(cuid())
  companyId        String
  shiftId          String
  assignmentId     String
  recordId         String                    @unique @db.Uuid
  method           CheckpointRecordMethod
  reason           InvalidScanReason
  scannedValue     String                    @db.VarChar(512)
  occurredAtDevice DateTime                  @db.Timestamptz(3)
  receivedAt       DateTime                  @default(now()) @db.Timestamptz(3)
  locationStatus   ShiftEventLocationStatus
  latitude         Decimal?                  @db.Decimal(9, 6)
  longitude        Decimal?                  @db.Decimal(10, 6)
  accuracyMeters   Decimal?                  @db.Decimal(10, 2)
  simulation       ShiftEventSimulation
  highlighted      Boolean                   @default(false)
  requestHash      String
  createdAt        DateTime                  @default(now())
  shift            Shift                     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  assignment       ShiftAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([companyId, shiftId, occurredAtDevice])
  @@index([shiftId, occurredAtDevice])
}

