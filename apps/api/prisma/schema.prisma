// Esquema de la base de datos de Garita.
// Todo cambio pasa por una migración: pnpm --filter api db:migrate --name <nombre_descriptivo>

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // La API compila a CommonJS; el cliente se genera en el mismo formato.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  supervisor
  guard
  client
}

enum UserStatus {
  invitation_pending
  active
  deactivated
}

enum InvitationSendStatus {
  pending
  sent
  failed
}

enum RecordStatus {
  active
  inactive
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  sites     Site[]
}

model User {
  id              String           @id @default(cuid())
  companyId       String
  firebaseUid     String           @unique
  email           String           @unique
  firstName       String
  lastName        String
  phone           String?
  employeeNumber  String?
  role            UserRole
  status          UserStatus       @default(invitation_pending)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitations     Invitation[]
  siteAssignments SiteSupervisor[]

  @@index([companyId])
}

model Client {
  id          String       @id @default(cuid())
  companyId   String
  name        String
  contactName String
  phone       String
  email       String
  taxId       String?
  status      RecordStatus @default(active)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sites       Site[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

model Site {
  id                 String           @id @default(cuid())
  companyId          String
  clientId           String
  name               String
  address            String
  latitude           Decimal          @db.Decimal(9, 6)
  longitude          Decimal          @db.Decimal(10, 6)
  accessInstructions String?
  observations       String?
  status             RecordStatus     @default(active)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client             Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supervisors        SiteSupervisor[]

  @@unique([clientId, name])
  @@index([companyId, status])
  @@index([clientId])
}

model SiteSupervisor {
  id         String   @id @default(cuid())
  companyId  String
  siteId     String
  userId     String
  assignedAt DateTime @default(now())
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([siteId, userId])
  @@index([companyId])
  @@index([userId])
}

model Invitation {
  id                String               @id @default(cuid())
  userId            String
  tokenHash         String               @unique
  expiresAt         DateTime
  usedAt            DateTime?
  replacedAt        DateTime?
  sendStatus        InvitationSendStatus @default(pending)
  providerMessageId String?
  createdAt         DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
