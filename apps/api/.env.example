# Copiar a .env y completar. Nunca commitear el archivo .env.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Orígenes permitidos por CORS, separados por coma (panel web)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (con compose.yaml: postgresql://garita:garita@localhost:5432/garita)
DATABASE_URL=postgresql://garita:garita@localhost:5432/garita

# Redis para las colas de BullMQ (con compose.yaml: redis://localhost:6379)
REDIS_URL=redis://localhost:6379
# Socket.IO Redis adapter for multi-instance deployments (disabled in local tests)
SOCKET_REDIS_ADAPTER_ENABLED=false

# Firebase Admin (obligatorias fuera de NODE_ENV=test)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
WEB_APP_URL=http://localhost:5173
RESEND_API_KEY=
RESEND_FROM=

# Firma HMAC-SHA256 de los códigos QR (mínimo 32 caracteres)
QR_SIGNING_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
# NFC_MASTER_KEY=32 caracteres hexadecimales; guardarla como secreto del servidor
# NFC_MASTER_KEY_VERSION=1

# Firma HMAC-SHA256 de las credenciales de turno (HU-13, mínimo 32 caracteres)
SHIFT_CREDENTIAL_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Cloudinary (opcional: la autorización de fotos responde 503 si falta alguna)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Destino temporal de pánico (GUARD_PHONE por defecto; recepción de plataforma: HU-37).
PANIC_SMS_DESTINATION_TYPE=GUARD_PHONE
# Un único número E.164; dejar comentado si no hay pasarela.
# PANIC_SMS_PLATFORM_NUMBER=+541100000000

# TODO(HU-24-proveedor): credencial del futuro proveedor de SMS (hoy solo log, sin envíos).
# SMS_PROVIDER_API_KEY=
