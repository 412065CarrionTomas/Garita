# Copiar a .env y completar. Nunca commitear el archivo .env.

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Orígenes permitidos por CORS, separados por coma (panel web)
CORS_ORIGINS=http://localhost:5173

# PostgreSQL (con compose.yaml: postgresql://garita:garita@localhost:5432/garita)
DATABASE_URL=postgresql://garita:garita@localhost:5432/garita

# Redis para las colas de BullMQ (con compose.yaml: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Firebase Admin (obligatorias fuera de NODE_ENV=test)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firma HMAC-SHA256 de los códigos QR (mínimo 32 caracteres)
QR_SIGNING_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
